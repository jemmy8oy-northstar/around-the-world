{
  "openapi": "3.1.1",
  "info": {
    "title": "AroundTheWorld.WebApi | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/api/status": {
      "get": {
        "tags": [
          "AroundTheWorld.WebApi"
        ],
        "operationId": "GetStatus",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/game": {
      "get": {
        "tags": [
          "GameRoutes"
        ],
        "summary": "Current game mode, active round and pub stop.",
        "operationId": "GetGameState",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameState"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GameMode": {
        "type": "integer"
      },
      "GameState": {
        "required": [
          "roundName"
        ],
        "type": "object",
        "properties": {
          "mode": {
            "$ref": "#/components/schemas/GameMode"
          },
          "roundId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "roundName": {
            "type": "string"
          },
          "currentStopNumber": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "goLiveAt": {
            "type": "string",
            "format": "date-time"
          },
          "readOnlyAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "AroundTheWorld.WebApi"
    },
    {
      "name": "GameRoutes"
    }
  ]
}