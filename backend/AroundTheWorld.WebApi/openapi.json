{
  "openapi": "3.1.1",
  "info": {
    "title": "AroundTheWorld.WebApi | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/api/status": {
      "get": {
        "tags": [
          "AroundTheWorld.WebApi"
        ],
        "operationId": "GetStatus",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/game": {
      "get": {
        "tags": [
          "GameRoutes"
        ],
        "summary": "Current game mode, active round and pub stop.",
        "operationId": "GetGameState",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameState"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/join": {
      "post": {
        "tags": [
          "AuthRoutes"
        ],
        "summary": "Exchange a username for a token pair. The host's name also needs the host code.",
        "operationId": "Join",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JoinRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthSession"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/refresh": {
      "post": {
        "tags": [
          "AuthRoutes"
        ],
        "summary": "Redeem a refresh token for a fresh pair.",
        "operationId": "Refresh",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthSession"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/posts": {
      "get": {
        "tags": [
          "PostRoutes"
        ],
        "summary": "The active round's feed, newest first. Filter with ?country=XX.",
        "operationId": "GetPosts",
        "parameters": [
          {
            "name": "country",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Post"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "PostRoutes"
        ],
        "summary": "Post a drink: photo, caption and the country it's from.",
        "operationId": "CreatePost",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "required": [
                  "photo",
                  "caption",
                  "countryCode"
                ],
                "type": "object",
                "allOf": [
                  {
                    "type": "object",
                    "properties": {
                      "photo": {
                        "$ref": "#/components/schemas/IFormFile"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "properties": {
                      "caption": {
                        "type": "string"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "properties": {
                      "countryCode": {
                        "type": "string"
                      }
                    }
                  }
                ]
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Post"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/posts/{postId}": {
      "delete": {
        "tags": [
          "PostRoutes"
        ],
        "summary": "Soft-deletes your own post — or any post, if you are the admin.",
        "operationId": "DeletePost",
        "parameters": [
          {
            "name": "postId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/countries": {
      "get": {
        "tags": [
          "CountryRoutes"
        ],
        "summary": "Post counts per country — the map badges and the leaderboard.",
        "operationId": "GetCountryTally",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CountryTally"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/me/channel-visit": {
      "post": {
        "tags": [
          "MeRoutes"
        ],
        "summary": "Records that you tapped through to the YouTube channel.",
        "operationId": "RecordChannelVisit",
        "responses": {
          "204": {
            "description": "No Content"
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/stop/next": {
      "post": {
        "tags": [
          "Admin"
        ],
        "operationId": "AdvancePubStop",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "integer",
                  "format": "int32"
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/round": {
      "post": {
        "tags": [
          "Admin"
        ],
        "operationId": "StartNewRound",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StartRoundRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "integer",
                  "format": "int32"
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/settings": {
      "put": {
        "tags": [
          "Admin"
        ],
        "operationId": "UpdateCutovers",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateCutoversRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    },
    "/api/admin/users/banned": {
      "get": {
        "tags": [
          "Admin"
        ],
        "summary": "The usernames currently shadow-banned, so the admin can see and lift a ban.",
        "operationId": "GetShadowBannedUsers",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/users/{username}/ban": {
      "post": {
        "tags": [
          "Admin"
        ],
        "operationId": "SetShadowBan",
        "parameters": [
          {
            "name": "username",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ShadowBanRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    },
    "/api/admin/users/{username}/release": {
      "post": {
        "tags": [
          "Admin"
        ],
        "operationId": "ReleaseUsername",
        "parameters": [
          {
            "name": "username",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    },
    "/api/admin/posts/{postId}": {
      "delete": {
        "tags": [
          "Admin"
        ],
        "operationId": "AdminDeletePost",
        "parameters": [
          {
            "name": "postId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AuthSession": {
        "required": [
          "accessToken",
          "refreshToken",
          "username"
        ],
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "accessTokenExpiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "refreshToken": {
            "type": "string"
          },
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "username": {
            "type": "string"
          },
          "isAdmin": {
            "type": "boolean"
          }
        }
      },
      "CountryTally": {
        "required": [
          "countryCode"
        ],
        "type": "object",
        "properties": {
          "countryCode": {
            "type": "string"
          },
          "postCount": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "GameMode": {
        "enum": [
          "Practice",
          "Live",
          "Finished"
        ]
      },
      "GameState": {
        "required": [
          "roundName"
        ],
        "type": "object",
        "properties": {
          "mode": {
            "$ref": "#/components/schemas/GameMode"
          },
          "roundId": {
            "type": "integer",
            "format": "int32"
          },
          "roundName": {
            "type": "string"
          },
          "currentStopNumber": {
            "type": "integer",
            "format": "int32"
          },
          "goLiveAt": {
            "type": "string",
            "format": "date-time"
          },
          "readOnlyAt": {
            "type": "string",
            "format": "date-time"
          },
          "youTubeUrl": {
            "type": "string"
          }
        }
      },
      "IFormFile": {
        "type": "string",
        "format": "binary"
      },
      "JoinRequest": {
        "required": [
          "username"
        ],
        "type": "object",
        "properties": {
          "partyCode": {
            "type": [
              "null",
              "string"
            ]
          },
          "username": {
            "type": "string"
          }
        }
      },
      "Post": {
        "required": [
          "username",
          "photoUrl",
          "caption",
          "countryCode"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "username": {
            "type": "string"
          },
          "photoUrl": {
            "type": "string"
          },
          "caption": {
            "type": "string"
          },
          "countryCode": {
            "type": "string"
          },
          "stopNumber": {
            "type": "integer",
            "format": "int32"
          },
          "authorVisitedChannel": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "RefreshRequest": {
        "required": [
          "refreshToken"
        ],
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string"
          }
        }
      },
      "ShadowBanRequest": {
        "type": "object",
        "properties": {
          "isShadowBanned": {
            "type": "boolean"
          }
        }
      },
      "StartRoundRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "UpdateCutoversRequest": {
        "type": "object",
        "properties": {
          "goLiveAt": {
            "type": "string",
            "format": "date-time"
          },
          "readOnlyAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "AroundTheWorld.WebApi"
    },
    {
      "name": "GameRoutes"
    },
    {
      "name": "AuthRoutes"
    },
    {
      "name": "PostRoutes"
    },
    {
      "name": "CountryRoutes"
    },
    {
      "name": "MeRoutes"
    },
    {
      "name": "Admin"
    }
  ]
}